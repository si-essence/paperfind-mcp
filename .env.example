# Contact address in the User-Agent, Crossref mailto, Europe PMC, PubMed, and Unpaywall.
# The default is this placeholder. Set an address you control before production use.
# Never commit a personal address, and never put an API key in this value.
PAPERS_CONTACT_EMAIL=contact@example.com

# Optional OpenAlex bearer token. At least 8 characters. Never printed.
# Keyless use is 10 requests/s. A key raises the connector cap to 30 requests/s.
OPENALEX_API_KEY=

# Optional NCBI E-utilities key. At least 8 characters. Sent only as api_key. Never printed.
# Without a key the cap is 3 requests/s. With a key it is 10 requests/s.
NCBI_API_KEY=

# Local sliding window for tool calls that miss the cache.
PAPERS_PER_MINUTE=60

# Cache TTL in seconds for successful upstream bodies. 0 disables caching.
PAPERS_CACHE_TTL_SEC=60

# Upstream timeout in milliseconds.
PAPERS_TIMEOUT_MS=20000

# stdio (default) or http. --http on the command line forces http.
# HTTP listens on 127.0.0.1 only and has no authentication.
MCP_TRANSPORT=stdio
PORT=3000
