{
  "name": "papers",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "Issah Abubakari (https://github.com/si-essence)",
  "homepage": "https://bot-essentials.netlify.app",
  "type": "module",
  "description": "MCP connector for academic paper metadata and links from arXiv, Crossref, OpenAlex, Europe PMC, PubMed, and DOAJ.",
  "bin": {
    "papers": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "ci": "npm run typecheck && npm run lint && npm run test && npm run build",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "fast-xml-parser": "^4.5.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
